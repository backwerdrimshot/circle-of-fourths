{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circle-of-fourths",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // Served only on circle-of-fourths.backwerdrhythmshop.com.
  // Keeping workers.dev off also means a deploy never reads the account-wide
  // workers.dev subdomain, which a token scoped to this one Worker cannot read.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "circle-of-fourths.backwerdrhythmshop.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
